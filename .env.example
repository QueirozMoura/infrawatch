# InfraWatch local configuration.
#
# 1. Copy this file:            cp .env.example .env
# 2. Restrict its permissions:  chmod 600 .env
# 3. Replace the placeholder below with a strong, unique password, e.g.:
#      openssl rand -base64 24 | tr -dc 'A-Za-z0-9' | head -c 24
#
# .env is ignored by Git. Never commit it or share its contents.
# The admin password only takes effect the first time Grafana creates its data
# volume; see the README to change it later.
GRAFANA_ADMIN_PASSWORD=change-me
